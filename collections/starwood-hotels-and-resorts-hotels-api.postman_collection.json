            },
            "url": {
              "path": [
                "v1",
                "hotels",
                "search"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "(Required) Two-letter ISO country code (e.g., US, CN, FR)"
                },
                {
                  "disabled": false,
                  "key": "province",
                  "value": "<string>",
                  "description": "Province or state code within the country (e.g., USIL, CNHP)"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City name for hotel search"
                },
                {
                  "disabled": false,
                  "key": "arrivalDate",
                  "value": "<date>",
                  "description": "(Required) Check-in date in YYYY-MM-DD format"
                },
                {
                  "disabled": false,
                  "key": "departureDate",
                  "value": "<date>",
                  "description": "(Required) Check-out date in YYYY-MM-DD format"
                },
                {
                  "disabled": false,
                  "key": "adults",
                  "value": "1",
                  "description": "Number of adult guests"
                },
                {
                  "disabled": false,
                  "key": "brand",
                  "value": "<string>",
                  "description": "Filter by Starwood brand code"
                },
                {
                  "disabled": false,
                  "key": "categoryMin",
                  "value": "<integer>",
                  "description": "Minimum SPG category for luxury filtering (1-7)"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
